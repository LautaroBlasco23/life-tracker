# Mobile API base URL.

# Two build modes:
# - Prod: copy this file to `.env` (git-ignored) and set the real API URL, e.g.
#   EXPO_PUBLIC_API_URL=https://api.your-domain.com/api — baked into the JS
#   bundle at build time. For EAS cloud builds, set it with
#   `eas env:push --environment production` instead.
# - Dev (emulator): this file is loaded only when bundling in development mode
#   (`expo start` / `npx expo run:android`). The Android emulator reaches the
#   host machine via 10.0.2.2.

EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api
