DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=your_database
DB_SSLMODE=disable

MONGO_URI=mongodb://user:password@localhost:27017/life_tracker?authSource=admin
MONGO_DATABASE=life_tracker
MONGO_USER=user
MONGO_PASSWORD=password

JWT_SECRET=your-secret-key-here
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

PORT=8080

# Keep gin's route-dump warnings in dev; prod defaults to release mode.
GIN_MODE=debug

# CORS: set explicit origins for any deployment reachable beyond localhost
# (e.g. http://localhost:3000,http://localhost:8081). "*" is dev-only.
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# AWS (real account) — the backend builds AWS clients when these are set.
# Not used by the home Docker deployment; leave empty/placeholder.
AWS_ENDPOINT_URL=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=lifetracker-images
S3_PUBLIC_URL=
SECRETS_JWT_NAME=life-tracker/jwt-secret

# Serverless mode (Lambda deployment); empty for the container/server path.
APP_RUNTIME=

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password_here
