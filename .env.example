DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=your_database
DB_SSLMODE=disable

MONGO_URI=mongodb://user:password@localhost:27017/life_tracker?authSource=admin
MONGO_DATABASE=life_tracker
MONGO_USER=user
MONGO_PASSWORD=password

JWT_SECRET=your-secret-key-here
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

PORT=8080

# Keep gin's route-dump warnings in dev; prod defaults to release mode.
GIN_MODE=debug

# CORS: set explicit origins for any deployment reachable beyond localhost
# (e.g. http://localhost:3000,http://localhost:8081). "*" is dev-only.
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# AWS (real account) — the backend builds AWS clients when these are set.
# Not used by the home Docker deployment; leave empty/placeholder.
#
# Local S3 emulator lane (official AWS Emulator, `aws-emulator` compose
# profile — see docker-compose.yml): set AWS_ENDPOINT_URL to the endpoint
# the api should upload to, and S3_PUBLIC_URL to the browser-facing image
# origin. The bucket, its public-read policy, and Block Public Access are
# provisioned by the backend on boot.
#   make dev (api on the host): talk plain HTTP to the s3-pipe bridge
#     (published on loopback by the same profile — no TLS/CA setup needed):
#     AWS_ENDPOINT_URL=http://127.0.0.1:9298
#   make dev-container (api in a container):
#     AWS_ENDPOINT_URL=http://s3-pipe:9297
#     (plain HTTP to the s3-pipe bridge; AWS_CA_BUNDLE must stay empty)
# Direct TLS to the emulator (https://127.0.0.1:9297 + AWS_CA_BUNDLE) also
# works, but couples the api to the emulator's per-start self-signed cert.
# In the container lanes leave S3_PUBLIC_URL unset: the backend defaults it
# to the web origin (http://127.0.0.1:3000), whose nginx proxies images
# same-origin (the emulator rejects non-same-origin browser fetches).
# Start the emulator with `make dev-container` or `make s3-emulator`.
AWS_ENDPOINT_URL=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=lifetracker-images
S3_PUBLIC_URL=
SECRETS_JWT_NAME=life-tracker/jwt-secret

# Serverless mode (Lambda deployment); empty for the container/server path.
APP_RUNTIME=

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password_here
