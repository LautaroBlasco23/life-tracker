# Rendered by nginx's built-in envsubst (docker-entrypoint.d) at startup.
# ${GATEWAY_UPSTREAM} and ${NGINX_LOCAL_RESOLVERS} (exported by the image's
# 15-local-resolvers.envsh) come from the environment; nginx variables like
# $uri are untouched because they are not defined env vars.
#
# The gateway's registered routes carry the /api prefix (backend/endpoints/
# *.json: "route": "/api/users"), so proxy_pass has NO URI part — the full
# /api/... path is forwarded unstripped.
#
# The upstream is resolved per-request via the Docker embedded resolver, so
# the frontend still boots when api-gateway is down or not yet on the network
# (a static upstream would abort nginx at startup: "host not found").
server {
    listen 3000;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
        set $gateway_upstream ${GATEWAY_UPSTREAM};
        proxy_pass http://$gateway_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Static export with trailingSlash: true emits per-route directories
    # (out/notes/index.html), so $uri/ is the deep-link fallback probe.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
