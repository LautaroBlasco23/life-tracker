# Base URL the frontend calls for the API. Read at runtime via window.__ENV__
# (injected into out/env-config.js by scripts/deploy.sh) or at build time via
# NEXT_PUBLIC_API_URL.
#
# Local backend (old container path): http://localhost:8080/api
# floci API Gateway (dev):            http://localhost:4566/execute-api/lifetracker-api/dev/api
# floci web app (same-origin proxy):  http://localhost:3000/api
# Prod (real AWS API Gateway):        https://<api-id>.execute-api.<region>.amazonaws.com/<stage>/api
NEXT_PUBLIC_API_URL=http://localhost:8080/api
