# Production TLS termination example for the life-tracker API + web frontend.
# (Host-side nginx, not the web container: terminate HTTPS on the host and
# proxy to the compose-published ports.)
#
# This file is a TEMPLATE, not a running config: copy it to
# /etc/nginx/conf.d/lifetracker.conf (or mount it into the web container),
# fill in <DOMAIN>, and obtain certificates — e.g. `certbot certonly --standalone`
# or `certbot --nginx` on the host. The base configs (nginx.conf,
# frontend nginx template) stay plain-HTTP dev configurations.
#
# Why this exists: until now no production TLS configuration shipped with the
# repo, so a home-server deployment had nothing to terminate HTTPS with.
#
# Setup checklist:
#   1. Point DNS at the server; forward 80 + 443 to it.
#   2. Issue certs: sudo certbot certonly --standalone -d <DOMAIN>
#   3. Replace <DOMAIN>; keep the 80 server only for the ACME challenge + redirect.
#   4. certbot renew hook reloads nginx automatically when installed with --nginx;
#      otherwise add a deploy/renew hook: nginx -s reload.

# --- API upstream (the Go backend, host port 8080) ---
upstream lifetracker_api {
    server 127.0.0.1:8080;
}

# --- Frontend static export (nginx served on :3000, or S3/CloudFront) ---
upstream lifetracker_web {
    server 127.0.0.1:3000;
}

# HTTP: ACME challenge + redirect everything else to HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name <DOMAIN>;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name <DOMAIN>;

    ssl_certificate     /etc/letsencrypt/live/<DOMAIN>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<DOMAIN>/privkey.pem;

    # Modern TLS only (Mozilla intermediate profile).
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # HSTS: safe to enable now that every path to this server is HTTPS.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # The backend already applies security headers; don't duplicate them
    # (nginx add_header directives on this server override upstream ones for
    # the proxied response when both define the same header name).

    # Web UI (same origin as the API, so the browser calls /api without CORS).
    location / {
        proxy_pass http://lifetracker_web;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /api/ {
        proxy_pass http://lifetracker_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        client_max_body_size 36m; # 32 MB import cap + multipart overhead
    }
}
