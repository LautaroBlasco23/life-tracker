{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    // This package is consumed as source by the apps, so it has no own
    // node_modules. Point type lookup at the web app's install for standalone
    // checks/editor support; the apps' own type-checks are the authoritative gate.
    "typeRoots": ["../../frontend/node_modules/@types"],
    "types": ["react", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
